# Secrets — NEVER commit these
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Local data
chroma_db/
*.log

# OS
Thumbs.db
.DS_Store

# Keep manuals + anything derived from them out of git (copyright) — regenerable, stay local only
manuals/
page_images/
fixes/

# Eval run artefacts: raw answers quote the manuals, logs are local noise
eval/results/*.jsonl
eval/results/*.log
eval/results/*.pid
eval/gold_review.md

# Local reranker model (downloaded on first use)
models/
eval/vague_review.md

# 3D car models: licences vary by model, so they stay local like the manuals
src/web/static/cars/*.glb
src/web/static/cars/*.gltf
src/web/static/cars/*.bin
